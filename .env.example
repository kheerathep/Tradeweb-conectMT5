# ==========================================
# Database Configuration Option A: Local MySQL (default)
# ==========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tradeweb
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=devroot

# ==========================================
# Database Configuration Option B: Supabase (PostgreSQL Cloud)
# To use Supabase, set SPRING_PROFILES_ACTIVE=supabase
# ==========================================
# Option B1: Direct JDBC URL from Supabase Project Settings -> Database
# Format: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Or via Transaction Pooler: jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Or via separate fields:
SUPABASE_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres

# ==========================================
# Server Configuration (Spring Boot)
# Options for profile: dev (MySQL) | supabase (Supabase PostgreSQL)
# ==========================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# Google OAuth 2.0 / Google Sign-In
# Create credentials in Google Cloud Console (APIs & Services -> Credentials)
# ==========================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ==========================================
# Security & JWT
# ==========================================
# High-entropy random 256-bit+ secret key (Base64 encoded or string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Encryption key for sensitive fields (32-character AES key)
APP_ENCRYPTION_KEY=my32charactersecretkeyforencrypt!

# ==========================================
# File Uploads
# ==========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ==========================================
# Frontend Configuration (.env inside frontend/)
# ==========================================
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

